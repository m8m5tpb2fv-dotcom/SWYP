{
  "name": "swyp",
  "private": true,
  "version": "0.0.1",
  "description": "Telegram-native Shorts platform (Mini App + Bot + Backend)",
  "scripts": {
    "dev:miniapp": "pnpm --filter @swyp/miniapp dev",
    "dev:admin": "pnpm --filter @swyp/admin dev",
    "dev:bot": "pnpm --filter @swyp/bot dev",
    "dev:api": "pnpm --filter @swyp/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
