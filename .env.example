# Telegram
TELEGRAM_BOT_TOKEN=
MINIAPP_URL=https://example.com

# API
API_PORT=3000
JWT_SECRET=change-me

# Database
DATABASE_URL=postgresql://swyp:swyp@localhost:5432/swyp

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible — matches docker/docker-compose.yml's MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=swyp-videos
STORAGE_ACCESS_KEY=swyp
STORAGE_SECRET_KEY=swyp-secret

# CDN — omit to fall back to STORAGE_ENDPOINT/STORAGE_BUCKET directly
CDN_BASE_URL=
