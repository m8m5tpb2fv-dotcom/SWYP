# Telegram
TELEGRAM_BOT_TOKEN=
MINIAPP_URL=https://example.com

# API
API_PORT=3000
JWT_SECRET=change-me

# Admin panel login (separate from Telegram users — see apps/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Database
DATABASE_URL=postgresql://swyp:swyp@localhost:5432/swyp

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible — matches docker/docker-compose.yml's MinIO).
# Video/thumbnail objects are private; the API signs a time-limited GET URL per
# request rather than serving a permanent public link.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=swyp-videos
STORAGE_ACCESS_KEY=swyp
STORAGE_SECRET_KEY=swyp-secret
# MinIO needs path-style URLs; Railway/Tigris and most other S3 providers need
# virtual-host style — set to "false" there.
STORAGE_FORCE_PATH_STYLE=true
