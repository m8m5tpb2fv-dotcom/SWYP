// Prisma schema. Full domain (follows, saves, views, reports, ...) per ТЗ
// section 20 lands incrementally; this step adds Video, Like and Comment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  telegramId String   @unique
  username   String?
  firstName  String?
  lastName   String?
  avatarUrl  String?
  isAdmin    Boolean  @default(false)
  isBanned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  videos   Video[]
  likes    Like[]
  comments Comment[]

  @@map("users")
}

enum VideoStatus {
  draft
  processing
  pending
  published
  rejected
  blocked
  deleted
}

model Video {
  id            String      @id @default(uuid())
  userId        String
  title         String?
  description   String?
  category      String?
  hashtags      String[]    @default([])
  status        VideoStatus @default(processing)
  videoUrl      String?
  thumbnailUrl  String?
  duration      Int?
  width         Int?
  height        Int?
  viewsCount    Int         @default(0)
  likesCount    Int         @default(0)
  commentsCount Int         @default(0)
  sharesCount   Int         @default(0)
  savesCount    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  publishedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]

  @@index([userId])
  @@index([status])
  @@map("videos")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
  @@map("likes")
}

enum CommentStatus {
  published
  hidden
  deleted
}

model Comment {
  id        String        @id @default(uuid())
  userId    String
  videoId   String
  parentId  String?
  text      String
  status    CommentStatus @default(published)
  createdAt DateTime      @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([videoId])
  @@index([parentId])
  @@map("comments")
}
