// Prisma schema. Full domain (follows, saves, views, reports, ...) per ТЗ
// section 20 lands incrementally; this step adds Video, Like and Comment.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; debian-openssl-3.0.x for the node:22-slim (Bookworm)
  // Docker images used on Railway — without this, the engine binary generated
  // matches whatever OpenSSL Prisma's heuristic guesses and fails to load at
  // runtime with "Unable to require ... libquery_engine-*.so.node".
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  telegramId String   @unique
  username   String?
  firstName  String?
  lastName   String?
  avatarUrl  String?
  bio        String?
  isAdmin    Boolean  @default(false)
  isBanned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // A user-chosen in-app handle, separate from `username` — the latter is
  // synced from Telegram's own profile on every login (see routes/auth.ts)
  // and would just overwrite anything set here. Null until the user sets
  // one during registration; display logic everywhere falls back to
  // username/firstName when it's unset.
  nickname String? @unique

  // One-time Stars purchase (see routes/monetization.ts) — a permanent
  // verified-account checkmark, not tied to any subscription or expiry.
  isVerified Boolean @default(false)

  // Null = this creator doesn't sell subscriptions. Set by the creator
  // themselves (PATCH /api/me) — buying one is a flat, non-recurring 30-day
  // pass (see CreatorSubscription) rather than Telegram's actual recurring
  // Stars subscription API, which would need its own renewal-webhook
  // lifecycle this codebase doesn't have yet.
  subscriptionPriceStars Int?

  videos              Video[]
  likes               Like[]
  comments            Comment[]
  followers           Follow[]             @relation("Followers")
  following           Follow[]             @relation("Following")
  reports             Report[]
  categoryScores      UserCategoryScore[]
  views               VideoView[]
  giftsSent           GiftTransaction[]    @relation("GiftsSent")
  giftsReceived       GiftTransaction[]    @relation("GiftsReceived")
  videoUnlocks        VideoUnlock[]
  subscriptionsBought CreatorSubscription[] @relation("SubscriptionsBought")
  subscriptionsSold   CreatorSubscription[] @relation("SubscriptionsSold")

  @@map("users")
}

// One-time Stars purchase unlocking a single premium video for one viewer,
// permanently — separate from CreatorSubscription, which unlocks every
// premium video from one creator but only for 30 days. A viewer might use
// either path depending on whether they just want this one video or watch
// that creator regularly.
model VideoUnlock {
  id               String   @id @default(uuid())
  userId           String
  videoId          String
  priceStars       Int
  telegramChargeId String?
  createdAt        DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
  @@map("video_unlocks")
}

// A flat-rate, non-renewing 30-day pass to one creator's premium videos,
// bought with Stars. Access is just `expiresAt > now()` — re-subscribing
// after expiry is a brand new payment, not an automatic renewal.
model CreatorSubscription {
  id               String   @id @default(uuid())
  subscriberId     String
  creatorId        String
  priceStars       Int
  expiresAt        DateTime
  telegramChargeId String?
  createdAt        DateTime @default(now())

  subscriber User @relation("SubscriptionsBought", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator    User @relation("SubscriptionsSold", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
  @@index([creatorId])
  @@map("creator_subscriptions")
}

// Long-press the like button on a video -> buy the author a real Telegram
// Gift with Stars. Paying and delivering are two separate Bot API calls
// (a Stars invoice, then sendGift spent from the bot's own star balance),
// so this row tracks the gap between them: pending_payment until Telegram
// confirms the invoice was paid (apps/bot's successful_payment handler),
// then either delivered (sendGift succeeded) or failed_refunded (sendGift
// failed — e.g. the bot's own star balance was too low — and the
// purchaser's stars were refunded via refundStarPayment rather than kept
// for a gift that never arrived).
model GiftTransaction {
  id               String                @id @default(uuid())
  purchaserId      String
  recipientId      String
  videoId          String?
  telegramGiftId   String
  starCount        Int
  status           GiftTransactionStatus @default(pending_payment)
  telegramChargeId String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  purchaser User   @relation("GiftsSent", fields: [purchaserId], references: [id], onDelete: Cascade)
  recipient User   @relation("GiftsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  video     Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([purchaserId])
  @@index([recipientId])
  @@map("gift_transactions")
}

enum GiftTransactionStatus {
  pending_payment
  delivered
  failed_refunded
}

// One row per (user, video) — caps viewsCount at one per unique viewer for
// that video's whole lifetime, rather than once per app session. Without
// this, closing and reopening the Mini App resets the client's in-memory
// "already impressed this video" set (see Feed.tsx impressedRef) and the
// same viewer re-watching inflates the count every time they come back.
model VideoView {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
  @@map("video_views")
}

// Per-user category affinity feeding the personalized feed (ТЗ раздел 5's
// personalization gap): built up by the analytics worker from watch-time
// ratio/completion (small increments — a passive signal) and likes (a larger,
// explicit-intent increment). /api/feed blends this with each video's global
// score and whether the viewer follows its author.
model UserCategoryScore {
  id        String   @id @default(uuid())
  userId    String
  category  String
  score     Float    @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("user_category_scores")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

enum VideoStatus {
  draft
  processing
  pending
  published
  rejected
  blocked
  deleted
}

model Video {
  id            String      @id @default(uuid())
  userId        String
  title         String?
  description   String?
  category      String?
  hashtags      String[]    @default([])
  status        VideoStatus @default(processing)
  objectKey     String?     @unique
  videoUrl      String?
  thumbnailUrl  String?
  duration      Int?
  width         Int?
  height        Int?
  viewsCount    Int         @default(0)
  likesCount    Int         @default(0)
  commentsCount Int         @default(0)
  sharesCount   Int         @default(0)
  savesCount    Int         @default(0)
  reportsCount  Int         @default(0)

  // Exclusive Shorts: priceStars is only meaningful when isPremium is true.
  // A viewer can unlock it individually (VideoUnlock) or already hold an
  // active CreatorSubscription to this video's author — either grants access.
  isPremium  Boolean @default(false)
  priceStars Int?

  // Recommendation inputs (ТЗ раздел 5/21/25) — watchTimeSum/completedViewsCount are
  // aggregated from video_watch events by the analytics worker; score is recomputed
  // from all of the above whenever any of them changes.
  watchTimeSum        Int   @default(0)
  completedViewsCount Int   @default(0)
  score               Float @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]
  reports  Report[]
  views    VideoView[]
  gifts    GiftTransaction[]
  unlocks  VideoUnlock[]

  @@index([userId])
  @@index([status])
  @@index([score])
  @@map("videos")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
  @@map("likes")
}

enum CommentStatus {
  published
  hidden
  deleted
}

model Comment {
  id        String        @id @default(uuid())
  userId    String
  videoId   String
  parentId  String?
  text      String
  status    CommentStatus @default(published)
  createdAt DateTime      @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([videoId])
  @@index([parentId])
  @@map("comments")
}

enum ReportReason {
  adult
  violence
  fraud
  spam
  copyright
  abuse
  other
}

enum ReportStatus {
  open
  resolved
  dismissed
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  videoId    String
  reason     ReportReason
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())

  reporter User  @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  video    Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([reporterId, videoId])
  @@index([status])
  @@map("reports")
}
